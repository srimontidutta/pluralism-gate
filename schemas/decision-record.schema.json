{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pluralism-gate:decision-record:1.0",
  "title": "Pluralism Gate Decision Record",
  "description": "JSON representation of the eight audit fields in Table 3, with stable identifiers for use across implementations.",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "decision_propositions",
    "standing",
    "admissible_reasons",
    "conflict_set",
    "task_state",
    "consultation",
    "resolution_warrant",
    "gate_outcome"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_propositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "proposition_id",
          "text"
        ],
        "properties": {
          "proposition_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "standing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stakeholder_id",
          "proposition_id",
          "basis"
        ],
        "properties": {
          "stakeholder_id": {
            "type": "string",
            "minLength": 1
          },
          "stakeholder_label": {
            "type": "string"
          },
          "proposition_id": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "admissible_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reason_id",
          "proposition_id",
          "polarity",
          "text",
          "attributed_stakeholders"
        ],
        "properties": {
          "reason_id": {
            "type": "string",
            "minLength": 1
          },
          "proposition_id": {
            "type": "string",
            "minLength": 1
          },
          "polarity": {
            "type": "string",
            "enum": [
              "support",
              "oppose"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "attributed_stakeholders": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "conflict_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Proposition identifiers in B_Pi(d)."
    },
    "task_state": {
      "type": "object",
      "required": [
        "requires_commitment"
      ],
      "properties": {
        "requires_commitment": {
          "type": "boolean"
        },
        "task_description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "consultation": {
      "type": "object",
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "route": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority_or_clarification_supplied": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "resolution_warrant": {
      "type": "object",
      "required": [
        "sufficient"
      ],
      "properties": {
        "sufficient": {
          "type": "boolean"
        },
        "authority_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "covers_conflicts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "gate_outcome": {
      "type": "object",
      "required": [
        "gate_invoked",
        "regime"
      ],
      "properties": {
        "gate_invoked": {
          "type": "boolean"
        },
        "regime": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "REPRESENT",
            "RESOLVE",
            "CONSULT",
            "DEFER",
            null
          ]
        },
        "final_commitment_or_preserved_disagreement": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Optional notes about modeling choices or implementation context for the record."
    }
  },
  "additionalProperties": true
}
